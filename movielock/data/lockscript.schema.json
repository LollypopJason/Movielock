{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LollypopJason/Movielock/lockscript.schema.json",
  "title": "Movielock script",
  "description": "The YAML/JSON form of a Lockscript. Every Lockscript file converts to exactly this structure and back.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shots"
  ],
  "properties": {
    "movielock": {
      "description": "Format version.",
      "const": 1
    },
    "format": {
      "description": "video = 16:9 landscape, reel = 9:16 vertical (shorts/reels/TikTok), square = 1:1.",
      "enum": [
        "video",
        "reel",
        "square"
      ],
      "default": "video"
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120,
      "default": 30
    },
    "map": {
      "$ref": "#/$defs/id",
      "description": "Map id from assets/library.yaml."
    },
    "captions": {
      "type": "boolean",
      "default": true
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "music": {
      "description": "Background music id (from library.yaml 'music'), optionally with a volume.",
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "volume": {
              "$ref": "#/$defs/volume"
            }
          }
        }
      ]
    },
    "cast": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cast"
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/shot"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_\\-]*$"
    },
    "time": {
      "type": "number",
      "minimum": 0
    },
    "volume": {
      "type": "number",
      "minimum": 0,
      "maximum": 4
    },
    "cast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "hero"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name",
          "description": "Name used in the script for this actor."
        },
        "hero": {
          "$ref": "#/$defs/id",
          "description": "Hero id from assets/library.yaml."
        },
        "position": {
          "description": "[x, y] or [x, y, z] in metres. Omit to let the planner spread the cast out.",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 3
        },
        "faces": {
          "description": "Another cast name to face, or a yaw in degrees (0 = facing -Y, toward the default camera side).",
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "number"
            }
          ]
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "camera": {
          "enum": [
            "wide",
            "medium",
            "closeup",
            "over_shoulder",
            "orbit",
            "dolly_in",
            "low_angle",
            "two_shot"
          ]
        },
        "on": {
          "$ref": "#/$defs/name",
          "description": "Cast member the camera is about."
        },
        "toward": {
          "$ref": "#/$defs/name",
          "description": "Second cast member (over_shoulder: whose shoulder; two_shot: the partner)."
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Minimum length in seconds. The shot is extended if its lines need more time."
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "anim",
            "voice",
            "tts",
            "sfx"
          ]
        }
      },
      "oneOf": [
        {
          "additionalProperties": false,
          "required": [
            "type",
            "actor",
            "anim"
          ],
          "properties": {
            "type": {
              "const": "anim"
            },
            "actor": {
              "$ref": "#/$defs/name"
            },
            "anim": {
              "$ref": "#/$defs/id"
            },
            "at": {
              "$ref": "#/$defs/time"
            },
            "once": {
              "type": "boolean",
              "description": "true = play once then return to the base animation; false = loop. Omitted: the library's loop setting for that animation."
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "type",
            "actor",
            "line"
          ],
          "properties": {
            "type": {
              "const": "voice"
            },
            "actor": {
              "$ref": "#/$defs/name"
            },
            "line": {
              "$ref": "#/$defs/id",
              "description": "Voice line id from assets/voices/index.yaml."
            },
            "at": {
              "$ref": "#/$defs/time"
            },
            "caption": {
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "type",
            "actor",
            "text"
          ],
          "properties": {
            "type": {
              "const": "tts"
            },
            "actor": {
              "$ref": "#/$defs/name"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "$ref": "#/$defs/time"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "type",
            "sound"
          ],
          "properties": {
            "type": {
              "const": "sfx"
            },
            "sound": {
              "$ref": "#/$defs/id"
            },
            "at": {
              "$ref": "#/$defs/time"
            },
            "volume": {
              "$ref": "#/$defs/volume"
            }
          }
        }
      ]
    }
  }
}
